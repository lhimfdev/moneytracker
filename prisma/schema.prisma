generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// All money is stored as integer centavos (PHP). Never floats.
model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  pinHash        String?
  pinFails       Int           @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime      @default(now())
  accounts       Account[]
  transactions   Transaction[]
  goals          Goal[]
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  balance      Int           @default(0) // cached; the ledger is the source of truth
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  goals        Goal[]

  @@index([userId])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type          TxType
  amount        Int // always positive centavos; type decides the direction
  date          DateTime @db.Date
  note          String?
  ref           String   @unique
  transferGroup String?
  idempotencyKey String?
  createdAt     DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
  @@index([accountId])
  @@index([transferGroup])
}

model Goal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name       String
  target     Int
  targetDate DateTime @db.Date
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}
